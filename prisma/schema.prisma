generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GROWTH_MANAGER
  SUPPORT_AGENT
  VIEWER
}
enum LifecycleStage {
  LEAD
  DISCOVERY
  CONSIDERATION
  CHECKOUT
  CUSTOMER
  REENGAGEMENT
  RETENTION
  SUPPORT
}
enum IntentType {
  DISCOVERY
  PRODUCT_RESEARCH
  PRODUCT_COMPARISON
  PURCHASE_READY
  PRICE_CONCERN
  TRUST_CONCERN
  DELIVERY_CONCERN
  PRODUCT_FIT_CONCERN
  STOCK_CONCERN
  PAYMENT_PROBLEM
  REFUND_OR_RETURN
  SUPPORT_REQUEST
  POST_PURCHASE
  REENGAGEMENT
  UNSUBSCRIBE
  UNKNOWN
}
enum RecordStatus {
  ACTIVE
  INACTIVE
}
enum ActionStatus {
  PENDING
  APPROVAL
  APPROVED
  EXECUTED
  BLOCKED
  FAILED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  assignedTickets SupportTicket[]
  approvals RecommendedAction[] @relation("ActionApprover")
}

model Customer {
  id String @id @default(cuid())
  externalId String? @unique
  firstName String?
  lastName String?
  email String @unique
  phone String?
  consentEmail Boolean @default(false)
  consentMarketing Boolean @default(false)
  lifecycleStage LifecycleStage @default(LEAD)
  acquisitionSource String?
  totalOrders Int @default(0)
  totalSpent Float @default(0)
  lastActivityAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carts Cart[]
  orders Order[]
  events CustomerEvent[]
  intents IntentAnalysis[]
  failures SaleFailureAnalysis[]
  actions RecommendedAction[]
  messages Message[]
  tickets SupportTicket[]
}

model Product {
  id String @id @default(cuid())
  externalId String? @unique
  name String
  description String
  category String?
  price Float
  currency String @default("USD")
  stockStatus String @default("IN_STOCK")
  metadata String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartItems CartItem[]
}

model Cart {
  id String @id @default(cuid())
  customerId String?
  sessionId String
  status String @default("OPEN")
  totalAmount Float @default(0)
  currency String @default("USD")
  abandonedAt DateTime?
  recoveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields: [customerId], references: [id])
  items CartItem[]
  payments PaymentAttempt[]
  failures SaleFailureAnalysis[]
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  productId String
  quantity Int
  unitPrice Float
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id String @id @default(cuid())
  externalId String @unique
  customerId String
  status String
  totalAmount Float
  currency String @default("USD")
  source String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  payments PaymentAttempt[]
}

model PaymentAttempt {
  id String @id @default(cuid())
  orderId String?
  cartId String?
  provider String
  status String
  failureCode String?
  failureMessage String?
  amount Float
  createdAt DateTime @default(now())
  order Order? @relation(fields: [orderId], references: [id])
  cart Cart? @relation(fields: [cartId], references: [id])
}

model CustomerEvent {
  id String @id @default(cuid())
  customerId String?
  sessionId String?
  eventType String
  eventData String @default("{}")
  source String
  occurredAt DateTime @default(now())
  customer Customer? @relation(fields: [customerId], references: [id])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  title String
  documentType String
  content String
  source String
  checksum String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id String @id @default(cuid())
  documentId String
  content String
  embedding String?
  metadata String @default("{}")
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model IntentAnalysis {
  id String @id @default(cuid())
  customerId String?
  sessionId String?
  intentType IntentType
  confidence Float
  evidence String @default("[]")
  model String
  createdAt DateTime @default(now())
  customer Customer? @relation(fields: [customerId], references: [id])
}

model SaleFailureAnalysis {
  id String @id @default(cuid())
  customerId String?
  cartId String?
  orderId String?
  primaryReason String
  secondaryReasons String @default("[]")
  confidence Float
  evidence String @default("[]")
  reasonType String @default("UNKNOWN")
  confirmedByHuman Boolean @default(false)
  createdAt DateTime @default(now())
  customer Customer? @relation(fields: [customerId], references: [id])
  cart Cart? @relation(fields: [cartId], references: [id])
}

model RecommendedAction {
  id String @id @default(cuid())
  customerId String?
  cartId String?
  actionType String
  reason String
  confidence Float
  status ActionStatus @default(PENDING)
  requiresApproval Boolean @default(false)
  approvedById String?
  executedAt DateTime?
  createdAt DateTime @default(now())
  customer Customer? @relation(fields: [customerId], references: [id])
  approver User? @relation("ActionApprover", fields: [approvedById], references: [id])
}

model Message {
  id String @id @default(cuid())
  customerId String
  channel String
  subject String
  body String
  providerMessageId String?
  status String @default("DRAFT")
  failureReason String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  customer Customer @relation(fields: [customerId], references: [id])
}

model Campaign {
  id String @id @default(cuid())
  name String
  status String @default("DRAFT")
  audienceRules String @default("{}")
  messageTemplate String
  channel String @default("EMAIL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id String @id @default(cuid())
  customerId String
  subject String
  description String
  priority String @default("NORMAL")
  status String @default("OPEN")
  assignedToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  assignedTo User? @relation(fields: [assignedToId], references: [id])
}

model AuditLog {
  id String @id @default(cuid())
  actorType String
  actorId String?
  action String
  targetType String
  targetId String?
  inputData String @default("{}")
  outputData String @default("{}")
  riskLevel String @default("LOW")
  createdAt DateTime @default(now())
}

model Integration {
  id String @id @default(cuid())
  provider String
  type String
  status String @default("NOT_CONFIGURED")
  configuration String @default("{}")
  lastTestedAt DateTime?
}
